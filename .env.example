# Copy to .dev.vars for local development (wrangler reads .dev.vars, not .env).
# In production set APP_URL, BETTER_AUTH_URL and EMAIL_FROM in wrangler.jsonc "vars",
# and the two secrets below with `wrangler secret put <NAME>`.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM=Desk <noreply@example.com>

# Secrets
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Optional: leave empty locally and emails are only logged to the console.
RESEND_API_KEY=
