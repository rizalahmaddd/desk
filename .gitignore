# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars
.dev.vars.*

# cloudflare
.wrangler/
.open-next/
# account-specific deploy config; copy wrangler.example.jsonc to create it
wrangler.jsonc

# private notes
/docs/private/

# local data
*.sqlite
*.sqlite3
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
